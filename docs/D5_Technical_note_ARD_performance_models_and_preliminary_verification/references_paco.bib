	keywords = {Azimuth, Coregistration, Decorrelation, Doppler effect, Earth observation satellite synthetic aperture radar mission, Earth orbit, Earthfixed orbital tube, Electron tubes, Orbits, Satellites, ScanSAR, Sentinel-1 mission, TOPS, Terrain Observation by Progressive Scans (TOPS), azimuth coregistration accuracy, azimuth spectral decorrelation, ground-track coverage repeatability, interferometric SAR (InSAR), interferometric spaceborne SAR mission, orbital tube, radar interferometry, remote sensing, repeat-pass interferometric compatibility, spaceborne radar, spectral decorrelation, synthetic aperture radar, synthetic aperture radar (SAR), terrain observation by progressive scan},
	pages = {1486--1490},
}

@article{mittermayerWrappedStaringSpotlight2016,
	title = {Wrapped {Staring} {Spotlight} {SAR}},
	volume = {54},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2016.2571340},
	abstract = {This paper proposes the wrapped staring spotlight (WSS) SAR imaging mode, which is a new method to extend the azimuth steering capability for phased array SAR to achieve either an improved azimuth geometric or radiometric resolution. It investigates the utility of steering directions with main lobe gains that are smaller than that of the grating lobes and exposes how these directions can be exploited. Furthermore, two methods are proposed to reduce the speckle and the image noise at once, i.e., the Look-Normalized Pattern Correction and the Ω-weighting. Based on two example TerraSAR-X WSS acquisitions, the image performance of extended and point targets is discussed.},
	number = {10},
