	keywords = {Azimuth, Geometry, Interference, Radar, Reflectivity, Signal analysis, Signal resolution, Solid modeling, aperture, circuit noise, performance analysis, resolution, signal-to-noise, synthetic, synthetic aperture radar, system},
	pages = {217--229},
}

