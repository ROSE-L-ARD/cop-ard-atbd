	keywords = {Area measurement, Coherence, Layout, Radar scattering, Radio interferometry, SAR interferometry, Temperature sensors, forest, forested terrain, forestry, general system model, geophysical method, geophysical techniques, interferometry, land surface topography, measurement technique, radar applications, radar imaging, radar measurements, radar remote sensing, radiometry, remote sensing, remote sensing by radar, repeat pass method, scene scattering, synthetic aperture radar, topographic map, topography (Earth), vegetation mapping},
	pages = {331--340},
}

