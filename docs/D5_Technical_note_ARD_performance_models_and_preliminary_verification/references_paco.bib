@article{lopez-dekker_phase_2008,
	title = {Phase {Synchronization} and {Doppler} {Centroid} {Estimation} in {Fixed} {Receiver} {Bistatic} {SAR} {Systems}},
	volume = {46},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2008.923322},
	abstract = {This paper discusses temporal and phase synchronization in bistatic synthetic aperture radar (SAR) systems that use orbital sensors as coherent sources of opportunity and receivers at a fixed location. The discussion is particularized to SAR Bistatic Receiver for INterferometric Applications (SABRINA), a ground-based bistatic receiver that uses ENVISAT and ERS-2 as transmitters. Transmitter-receiver synchronization is hindered by the presence of independent reference oscillators at the transmit and receive end and by the lack of a common time frame. Phase synchronization and pulse alignment are achieved using a dedicated channel that receives a clean signal directly from the satellite. How to align the acquired data with the satellite orbit and how to estimate the Doppler centroid (DC) are studied. It is shown that in the bistatic configuration considered, the receiver provides an implicit control point which limits the negative impact of a DC misestimation on the resulting images. An algorithm to achieve this temporal alignment using the apparent phase history of the received pulses is proposed. Finally, this algorithm is validated through Monte Carlo simulations and experimental data acquired by SABRINA.},
	number = {11},
	journal = {Geoscience and Remote Sensing, IEEE Transactions on},
	author = {Lopez-Dekker, P. and Mallorqui, J.J. and Serra-Morales, P. and Sanz-Marcos, J.},
	year = {2008},
	keywords = {Bistatic radar, Doppler centroid estimation, ENVISAT, ERS-2, Monte Carlo methods, Monte Carlo simulation, SABRINA, SAR Bistatic Receiver for INterferometric Applications, fixed receiver bistatic SAR system, independent reference oscillator, orbital sensors, phase synchronization, pulse alignment, receivers, remote sensing by radar, satellite communication, spaceborne radar, synchronisation, synchronization, synthetic aperture radar, synthetic aperture radar (SAR), transmitter-receiver synchronization, transmitters},
	pages = {3459--3471},
}

