@article{monti_guarnieri_exploitation_2008,
	title = {On the {Exploitation} of {Target} {Statistics} for {SAR} {Interferometry} {Applications}},
	volume = {46},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2008.2001756},
	abstract = {This paper focuses on multiimage synthetic aperture radar interferometry (InSAR) in the presence of distributed scatterers, paying particular attention to the role of target decorrelation in the estimation process. This phenomenon is accounted for by splitting the analysis into two steps. In the first step, we estimate the interferometric phases from the data, whereas in the second step, we use these phases to retrieve the physical parameters of interest, such as line-of-sight (LOS) displacement and residual topography. In both steps, we make the hypothesis that target statistics are at least approximately known. This approach is suited both to derive the performances of InSAR with different decorrelation models and for providing an actual estimate of LOS motion and topography. Results achieved from Monte Carlo simulations and a set of repeated pass ENVISAT images are shown.},
	number = {11},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Monti Guarnieri, A. and Tebaldini, S.},
	month = nov,
	year = {2008},
	keywords = {Decorrelation, ENVISAT images, Information retrieval, Monte Carlo simulations, Phase estimation, Radar scattering, SAR interferometry applications, Statistical distributions, Statistics, Stochastic processes, Surfaces, Synthetic aperture radar interferometry, Yield estimation, decorrelation models, geophysical techniques, geophysics computing, image processing, interferometric phases, interferometry, line-of-sight displacement, line-of-sight motion, maximum likelihood estimation, multiimage synthetic aperture radar interferometry, physical parameters, radar interferometry, remote sensing by radar, residual topography, synthetic aperture radar, target statistics, topography (Earth)},
	pages = {3436--3443},
}

@inproceedings{de_zan_mission_2009,
	title = {Mission design and performance for systematic deformation measurements with a spaceborne {SAR} system},
	volume = {2},
	doi = {10.1109/IGARSS.2009.5418212},
	abstract = {Tandem-L is an L-band SAR satellite mission currently under study at DLR. It is intended to serve a number of geophysical applications in several domains, like solid Earth, ecosystems and cryosphere. The various applications compete for the system resources and the mission design optimization requires that a performance model is developed for each application in order to allow motivated choices. We describe the adopted approach for deformation measurements, which is based on recent formulations of the Cramer-Rao bound for multi-image SAR interferometry and on the a-posteriori combination of the measurements from different lines of sight. We also discuss the limitations that the use of a reduced set of interferograms would entail.},
	booktitle = {Geoscience and {Remote} {Sensing} {Symposium},2009 {IEEE} {International},{IGARSS} 2009},
	author = {De Zan, F. and Prats, P. and Krieger, G.},
	month = jul,
	year = {2009},
	keywords = {Cramer-Rao bound, Current measurement, DLR, Decorrelation, Geophysical measurements, German Aerospace Center, L-band, L-band SAR satellite mission, Satellites, Sea measurements, Tandem-L, a-posteriori data combination, geophysical image processing, multiimage SAR interferometry, phase noise, radar imaging, radar interferometry, resource management, sensor fusion, spaceborne SAR system mission design, spaceborne SAR system performance, spaceborne radar, synthetic aperture radar, systematic deformation measurements},
	pages = {II--793--II--796},
}

@inproceedings{yokota_palsar-2_2014,
	title = {{PALSAR}-2 initial mission check},
	doi = {10.1109/IGARSS.2014.6947214},
	abstract = {PALSAR-2 (Phased Array type L-band Synthetic Aperture Radar-2) is a spaceborne L-band SAR (Synthetic Aperture Radar) system installed on Japanese Advanced Land Observing Satellite-2 (ALOS-2). PALSAR-2 is expected to provide valuable data for global monitoring and disaster monitoring. To meet the variety of demands, PALSAR-2 provides various operational modes. This paper describes the overview of the calibration plan of PALSAR-2. Since PALSAR-2 have more than 1,000 operational modes, effective and efficient procedure is crucial. The process is divided in three different phases; pre-launch calibration, check-out phase (C/O phase) after the launch, and image calibration phase. The overview of each phase is described.},
	booktitle = {Geoscience and {Remote} {Sensing} {Symposium} ({IGARSS}), 2014 {IEEE} {International}},
	author = {Yokota, Y. and Okada, Y. and Nakamura, S. and Iribe, K. and Tsuji, M. and Hariu, K. and Kankaku, Y. and Suzuki, S. and Shimada, M.},
