	keywords = {Electromagnetic scattering, Radar scattering, Sampling methods, Satellites, Signal resolution, Tomography, adaptive processing, adaptive signal processing, baseline-time acquisition patterns, baseline-time spectral analysis, coherent multilooking processing, differential SAR tomography, electromagnetic tomography, elevation-velocity resolution, full-resolution adaptive differential tomography, geophysical signal processing, interferometry, multidimensional signal processing, multiple scatterers, radar interferometry, range-azimuth full resolution, single-look adaptive differential tomographic processor, spaceborne radar, sparse sampling, spectral analysis, synthetic aperture radar, velocity measurement},
	pages = {III--176--III--179},
}

