@article{davis_depth_1993,
	title = {The depth of penetration in {Antarctic} firn at 10 {GHz}},
	volume = {31},
	issn = {0196-2892},
	doi = {10.1109/36.263784},
	abstract = {Measurements taken by an X-band pulse radar system in East Antarctica in 1987 were analyzed to determine the depth of penetration of radar energy in polar firn. A minimum estimate of the penetration depth at 10 GHz for the cold and dry polar plateau region is approximately 4.7 m. Spatial variations in the amount of signal penetration were observed and are related to latitude, surface elevation, and mean annual temperature. The amount of signal penetration and its spatial variation are important factors that should be considered when processing datasets from microwave remote sensing systems that operate in the polar regions},
