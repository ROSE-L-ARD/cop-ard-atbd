@article{said_ocean_2014,
	title = {Ocean {Surface} {Wind} {Retrieval} {From} {Dual}-{Polarized} {SAR} {Data} {Using} the {Polarization} {Residual} {Doppler} {Frequency}},
	volume = {52},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2013.2278550},
	abstract = {An alternative approach to sea surface wind retrieval using synthetic aperture radar (SAR) stripmap (SM) data is explored in this paper, using both the polarization residual Doppler frequency (PRDF) - the difference between the VV and HH Doppler centroids - and the normalized radar cross section (NRCS). The PRDF not only enables the possible elimination of unwanted biases present in both VV and HH Doppler estimates but also helps decrease the number of wind ambiguities down to two. In order to successfully infer the wind field from the PRDF, the use of a geophysical Doppler model function, such as the general curvature model (GCM)-Dop, is necessary. Using such a function, a simulated version of the PRDF at X-band is analyzed in terms of the sea surface wind field at various incidence angles. Simulations first show that the PRDF increases with increasing incidence angle regardless of wind field conditions. Actual PRDF measurements also exhibit strong correlation with radial components of the wind speed. An alternate SAR wind retrieval procedure, incorporating both the PRDF and the NRCS, is tested on a series of dual-polarized SM TerraSAR-X scenes carefully selected along the Norwegian coast. The geophysical model functions used for this analysis are the GCM-NRCS and GCM-Dop. A 1.13-m/s bias, with a correlation of 0.85 and a 1.86-m/s rmse, exists between the mean estimated wind speeds and in situ measurements, while a 15.43° bias, with a 0.93 correlation coefficient and a 34.1° rmse, is found between the mean estimated wind directions and in situ measurements.},
	number = {7},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Said, F. and Johnsen, H.},
	month = jul,
	year = {2014},
	keywords = {Doppler effect, Doppler measurements, Doppler radar, GCM-Dop, GCM-NRCS, HH Doppler centroid, HH Doppler estimate, Normalized radar cross section, Norwegian coast, PRDF measurement, SAR wind retrieval procedure, Sea measurements, Sea surface, VV Doppler centroid, VV Doppler estimate, Wind speed, X-band, atmospheric techniques, correlation coefficient, dual-polarized SAR data, dual-polarized SM TerraSAR-X scene, general curvature model, geophysical Doppler model function, geophysical measurement techniques, geophysical model function, incidence angle, ocean surface wind retrieval, oceanographic regions, polarization residual Doppler frequency, radar cross-sections, radar polarimetry, radial component, remote sensing by radar, sea surface wind retrieval, spaceborne radar, synthetic aperture radar, synthetic aperture radar (SAR), synthetic aperture radar stripmap data, unwanted bias elimination, wind, wind ambiguity, wind direction, wind field condition},
	pages = {3980--3990},
}

@article{mouche_dual-polarization_2005,
	title = {Dual-polarization measurements at {C}-band over the ocean: results from airborne radar observations and comparison with {ENVISAT} {ASAR} data},
	volume = {43},
	issn = {0196-2892},
	shorttitle = {Dual-polarization measurements at {C}-band over the ocean},
	doi = {10.1109/TGRS.2005.843951},
	abstract = {This paper presents an analysis of measurements of the normalized radar cross-section (NRCS) in vertical and horizontal polarizations over the ocean obtained from the C-band airborne radar STORM. The dataset was collected during the experiment called "Validation with a Polarimetric Airborne Radar of ENVISAT SAR over the Ocean (VALPARESO)", which took place during the calibration/validation phase of the ENVISAT Advanced Synthetic Aperture Radar (ASAR). From this dataset, the properties of the polarization ratio are discussed and in particular its dependencies with radar geometry (incidence and azimuth angle) as well as with meteorological conditions (wind and sea state). The polarization ratio is found to be dependent on incidence and azimuth angles. Its dependence with incidence angle is found to be significantly different from empirical models previously proposed in the literature. It also exhibits some correlation with surface conditions (wind and wave) with a more important correlation with significant wave steepness. Two new analytical formulations are proposed to model the polarization ratio, one as a function of incidence angle only, the second one with additional dependence with azimuth angle. It is shown that it is necessary to consider an azimuth-dependent polarization ratio for incidence angles larger than 30°. Comparisons with the polarization ratio from ENVISAT ASAR images are used to assess this model.},
	number = {4},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Mouche, A.A. and Hauser, D. and Daloze, J.-F. and Guerin, C.},
	month = apr,
	year = {2005},
	keywords = {Azimuth, C-band airborne radar, Calibration, ENVISAT ASAR data, ENVISAT Advanced Synthetic Aperture Radar, NRCS, Normalized radar cross-section (NRCS), Oceans, Polarization, STORM, Sea measurements, VALPARESO, Validation with a Polarimetric Airborne Radar of ENVISAT SAR over the Ocean, Wind speed, airborne radar, airborne radar observations, azimuth angle, dual-polarization measurements, horizontal polarization, incidence angle, meteorological conditions, meteorological radar, normalized radar cross-section, ocean surface, ocean wave, ocean waves, oceanographic techniques, polarization difference, polarization ratio, radar cross section, radar cross-sections, radar geometry, radar polarimetry, remote sensing by radar, sea state, storms, surface conditions, synthetic aperture radar, synthetic aperture radar (SAR), validation, vertical polarization, wave steepness, wavebreaking, wind, wind state},
	pages = {753--769},
}

@article{mouche_use_2012,
	title = {On the {Use} of {Doppler} {Shift} for {Sea} {Surface} {Wind} {Retrieval} {From} {SAR}},
	volume = {50},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2011.2174998},
	abstract = {The synthetic aperture radar (SAR) Doppler centroid has been used to estimate the scatter line-of-sight radar velocity. In weak to moderate ocean surface current environment, the SAR Doppler centroid is dominated by the directionality and strength of wave-induced ocean surface displacements. In this paper, we show how this sea state signature can be used to improve surface wind retrieval from SAR. Doppler shifts of C-band radar return signals from the ocean are thoroughly investigated by colocating wind measurements from the ASCAT scatterometer with Doppler centroid anomalies retrieved from Envisat ASAR. An empirical geophysical model function (CDOP) is derived, predicting Doppler shifts at both VV and HH polarization as function of wind speed, radar incidence angle, and wind direction with respect to radar look direction. This function is used into a Bayesian inversion scheme in combination with wind from a priori forecast model and the normalized radar cross section (NRCS). The benefit of Doppler for SAR wind retrieval is shown in complex meteorological situations such as atmospheric fronts or low pressure systems. Using in situ information, validation reveals that this method helps to improve the wind direction retrieval. Uncertainty of the calibration of Doppler shift from Envisat ASAR hampers the inversion scheme in cases where NRCS and model wind are accurate and in close agreement. The method is however very promising with respect of future SAR missions, in particular Sentinel-1, where the Doppler centroid anomaly will be more robustly retrieved.},
	number = {7},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Mouche, A.A. and Collard, F. and Chapron, B. and Dagestad, K. and Guitton, G. and Johannessen, J.A. and Kerbaol, V. and Hansen, M.W.},
	month = jul,
	year = {2012},
	keywords = {ASCAT scatterometer, Bayes methods, Bayesian inversion scheme, C-band radar return signal, Doppler, Doppler centroid anomaly, Doppler radar, Doppler shift, Envisat ASAR, HH polarization, Normalized radar cross section, SAR Doppler centroid, Sea surface, Sentinel-1, VV polarization, Wind speed, a priori forecast model, atmospheric front, atmospheric techniques, data acquisition, empirical geophysical model function, inverse problems, low pressure system, meteorological radar, meteorological situation, ocean surface current environment, ocean waves, radar cross-sections, radar incidence angle, radar look direction, remote sensing by radar, scatter line-of-sight radar velocity estimation, sea state signature, sea surface wind retrieval, surface wind, synthetic aperture radar, synthetic aperture radar (SAR), velocity measurement, wave-induced ocean surface displacement, wind, wind direction retrieval, wind measurement},
	pages = {2901--2909},
}

