	keywords = {Array signal processing, Azimuth, Design optimization, HRWS-SAR imaging, High-resolution imaging, Image resolution, Performance evaluation, Reconstruction algorithms, Signal resolution, azimuth processing strategy, digital beamforming, geophysical signal processing, geophysical techniques, high resolution wide swath SAR imaging, image reconstruction, multi-aperture synthetic aperture radar systems, optimisation, optimization strategy, pattern tapering, prebeamshaping on receive networks, radar imaging, radar polarimetry, reconstruction algorithm, signal processing, synthetic aperture radar, virtual position},
	pages = {1836--1839},
}

