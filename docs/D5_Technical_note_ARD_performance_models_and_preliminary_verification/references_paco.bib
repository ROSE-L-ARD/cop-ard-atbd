	volume = {53},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2015.2445057},
	abstract = {A Doppler centroid Dc model based on the generalized curvature ocean surface scattering model (generalized curvature model or GCM) is presented. Two key features are included in this model: a skewness-related phase coefficient based on empirical skewness coefficients of sea-surface-slope probability density function (pdf) for wind speed less than 10 m/s and effects from wave breaking for wind speed greater than 10 m/s. Simulated Dc values are exclusively compared with the empirical geophysical Doppler model function named CDOP, for hh and vv polarizations, various wind conditions, and incidence angles. Good agreement is found overall between CDOP and simulated Dc values. The overall bias for simulated Dc-hh with and without skewness are 2.63 versus -0.51 Hz (14.6 versus -2.8 cm/s), respectively; overall standard deviations are 2.76 versus 3.53 Hz (15.3 versus 19.6 cm/s). For simulated Dc-vv,overall bias values with and without skewness are -0.16 versus -2.52 Hz (-0.9 versus -14 cm/s); standard deviations are 3.56 versus 4.32 Hz (19.7 versus 24 cm/s). The overall bias for simulated Dc-hh with and without the wave breaking component are -0.08 versus 0.12 Hz (-0.4 versus 0.7 cm/s), respectively; corresponding standard deviations are 3.32 versus 4.75 Hz (18.4 versus 26.3 cm/s). Bias values for simulated Dc-vv with and without the wave breaking component are -1.83 versus -2.02 Hz (-10.2 versus -11.2 cm/s), with corresponding overall standard deviations of 3.43 versus 4.87 Hz (19 versus 27 cm/s). The largest deviation from CDOP, of about 18 Hz (0.99 m/s), is found in the upwind direction for a 26° incidence angle, 10-m/s wind speed, and hh polarization.},
	number = {12},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Saïd, F. and Johnsen, H. and Chapron, B. and Engen, G.},
	month = dec,
	year = {2015},
	keywords = {CDOP, Doppler centroid model, Doppler effect, Doppler measurements, HH polarization, Sea surface, Standards, Surface waves, VV polarization, Wind speed, empirical geophysical Doppler model function, empirical skewness coefficients, generalized curvature ocean surface scattering model, geophysical measurement techniques, ocean waves, ocean wind doppler model, oceanographic techniques, probability, remote sensing by radar, sea-surface-slope probability density function, skewness-related phase coefficient, standard deviations, synthetic aperture radar, synthetic aperture radar (SAR), upwind direction, wind},
	pages = {6632--6638},
}

@article{macedo_autofocus_2008,
	title = {An {Autofocus} {Approach} for {Residual} {Motion} {Errors} {With} {Application} to {Airborne} {Repeat}-{Pass} {SAR} {Interferometry}},
	volume = {46},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2008.924004},
	abstract = {Airborne repeat-pass SAR systems are very sensible to subwavelength deviations from the reference track. To enable repeat-pass interferometry, a high-precision navigation system is needed. Due to the limit of accuracy of such systems, deviations in the order of centimeters remain between the real track and the processed one, causing mainly undesirable phase undulations and misregistration in the interferograms, referred to as residual motion errors. Up to now, only interferometric approaches, as multisquint, are used to compensate for such residual errors. In this paper, we present for the first time the use of the autofocus technique for residual motion errors in the repeat-pass interferometric context. A very robust autofocus technique has to be used to cope with the demands of the repeat-pass applications. We propose a new robust autofocus algorithm based on the weighted least squares phase estimation and the phase curvature autofocus (PCA) extended to the range-dependent case. We call this new algorithm weighted PCA. Different from multisquint, the autofocus approach has the advantage of being able to estimate motion deviations independently, leading to better focused data and correct impulse-response positioning. As a consequence, better coherence and interferometric-phase accuracy are achieved. Repeat-pass interferometry based only on image processing gains in robustness and reliability, since its performance does not deteriorate with time decorrelation and no assumptions need to be made on the interferometric phase. Repeat-pass data of the E-SAR system of the German Aerospace Center (DLR) are used to demonstrate the performance of the proposed approach.},
	number = {10},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Macedo, K. A. C. de and Scheiber, R. and Moreira, A.},
	month = oct,
	year = {2008},
	keywords = {Airborne, E-SAR system, Estimation, German Aerospace Center, Least squares approximation, Motion estimation, Navigation, Phase estimation, Principal component analysis, Robustness, Tracking, airborne repeat-pass SAR Interferometry, autofocus, autofocus algorithm, autofocus techniques, deformation, differential synthetic-aperture-radar interferometry (D-InSAR), focusing, geophysical techniques, high-precision navigation system, image processing, interferometric-phase accuracy, interferometry, phase curvature autofocus, residual motion error, residual motion errors, synthetic aperture radar, synthetic-aperture-radar, terrain deformations measurement, topography (Earth), weighted least squares phase estimation},
	pages = {3151--3162},
}

@inproceedings{rodriguez-cassola_cosar:_2016,
	title = {{CoSAR}: {Geometrical} {Analysis} and {Image} {Formation} {Assessment}},
	shorttitle = {{CoSAR}},
	abstract = {Correlating SAR (CoSAR) is an innovative remote sensing concept which delivers large-scale coverage of ocean surfaces with a high repeat cycle. The main specific measurements provided by CoSAR are estimates of the normalised radar cross section (NRCS), Doppler shifts, and surface topography with higher resolution than microwave radiometers and larger coverage than state-of-the-art LEO SAR constellations. This paper analyses the specific geometrical characteristics of CoSAR surveys, keeping an eye in the future development of efficient CoSAR image formation approaches. Far from being foreign to SAR, the paper will show that CoSAR image formation can benefit from the available knowledge in efficient bistatic and multistatic SAR image formation approaches.},
	booktitle = {Proceedings of {EUSAR} 2016: 11th {European} {Conference} on {Synthetic} {Aperture} {Radar}},
	author = {Rodriguez-Cassola, M. and Lopez-Dekker, P. and Prats-Iraola, P. and Zan, F. De and Krieger, G. and Moreira, A.},
	month = jun,
	year = {2016},
	pages = {1--4},
}

@article{johnson_validation_2007,
	title = {Validation and {Error} {Analysis} of {OSCAR} {Sea} {Surface} {Currents}},
	volume = {24},
	issn = {0739-0572},
	url = {http://journals.ametsoc.org/doi/full/10.1175/JTECH1971.1},
	doi = {10.1175/JTECH1971.1},
	abstract = {Comparisons of OSCAR satellite-derived sea surface currents with in situ data from moored current meters, drifters, and shipboard current profilers indicate that OSCAR presently provides accurate time means of zonal and meridional currents, and in the near-equatorial region reasonably accurate time variability (correlation = 0.5–0.8) of zonal currents at periods as short as 40 days and meridional wavelengths as short as 8°. At latitudes higher than 10° the zonal current correlation remains respectable, but OSCAR amplitudes diminish unrealistically. Variability of meridional currents is poorly reproduced, with severely diminished amplitudes and reduced correlations relative to those for zonal velocity on the equator. OSCAR’s RMS differences from drifter velocities are very similar to those experienced by the ECCO (Estimating the Circulation and Climate of the Ocean) data-assimilating models, but OSCAR generally provides a larger ocean-correlated signal, which enhances its ratio of estimated signal over noise. Several opportunities exist for modest improvements in OSCAR fidelity even with presently available datasets.},
	number = {4},
	urldate = {2017-03-20},
	journal = {Journal of Atmospheric and Oceanic Technology},
	author = {Johnson, Eric S. and Bonjean, Fabrice and Lagerloef, Gary S. E. and Gunn, John T. and Mitchum, Gary T.},
	month = apr,
	year = {2007},
	pages = {688--701},
}

@article{reid_total_1994,
	title = {On the total geostrophic circulation of the {North} {Atlantic} {Ocean}: {Flow} patterns, tracers, and transports},
	volume = {33},
	issn = {0079-6611},
	shorttitle = {On the total geostrophic circulation of the {North} {Atlantic} {Ocean}},
	url = {http://www.sciencedirect.com/science/article/pii/0079661194900140},
	doi = {10.1016/0079-6611(94)90014-0},
	abstract = {This is an attempt to provide patterns of flow at all depths in the North Atlantic Ocean that balance the transport and are consistent with the patterns of characteristics. It identifies the paths of flow and the sources of the characteristics. In particular it attempts to account for the high heat and salt content of the deep North Atlantic in terms of an increment of very warm and saline Mediterranean water that partly circulates within the anticyclonic gyre of the North Atlantic and the cyclonic gyre to the south and east before passing southward into the South Atlantic. The direct effect of the Mediterranean outflow is to provide heat and salt to these gyres. The deeper water of these gyres has entered from the South Atlantic at depths below 1500 m and is colder and less saline than the waters to the north. The increment of heat and salt that pours into these waters as they pass northward along the eastern boundary is carried both northward to Iceland and westward across the Atlantic. Part of the northward flow carries higher salinities to mix with Norwegian Sea waters and become denser, though still relatively warm and saline. The westward component provides the high heat and salt content of the deep Gulf Stream and of the southward flow along the western boundary. As a result the 0.7 × 106m3s−1 of very warm and saline water from the Mediterranean Sea is not immediately carried southward out of the North Atlantic but only after some excursions through these gyres. The residence time of the increments in the North Atlantic is therefore longer, and leads to an accumulation of heat and salt.},
	number = {1},
	urldate = {2017-03-20},
	journal = {Progress in Oceanography},
	author = {Reid, Joseph L},
	month = jan,
	year = {1994},
	pages = {1--92},
}

