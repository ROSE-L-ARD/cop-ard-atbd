	month = jan,
	year = {2001},
	keywords = {Altimetry, Bistatic radar, Delay, Extrapolation, GNSS, GPS, Global Positioning System, Low earth orbit satellites, Oceans, PARIS concept, Reflectometry, Satellite navigation systems, Sea level, Sea surface, dynamics, experimental demonstration, global navigation satellite systems, interferometry, measurement technique, mesoscale, ocean, oceanographic techniques, passive reflectometry, passive reflectometry and interferometry system, radiowave reflection, reflected signal, remote sensing, remote sensing by radar, sea surface altimetry, sea surface height},
	pages = {142--150},
}

