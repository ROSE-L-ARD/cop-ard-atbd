	year = {1992},
	keywords = {Calibration, Earth surface, Equations, Image quality, airborne data, backscatter, interferometric SAR, phase calibration, polarimetric radar calibration, polarimetry, radar backscatter, radar imaging, radar measurements, radar polarimetry, radiometric calibration, radiometry, reviews, spaceborne SAR image data, spaceborne radar, synthetic aperture radar, synthetic-aperture radar},
