	doi = {10.1109/ICASSP.2008.4518146},
	abstract = {We introduce and investigate the concept of random sampling to the problem of image reconstruction in a multistatic SAR system. We first develop an appropriate figure of merit for the invertibility of the measurement data. We then show numerical simulations of a particular random measurement process under various parameters and compare the performance of this random sampling to that of the sampling given by a deterministic elliptical transform. We expose new connections between SAR processing and random matrix theory, and develop a fundamental result relating image quality to SAR system parameters for this mode.},
