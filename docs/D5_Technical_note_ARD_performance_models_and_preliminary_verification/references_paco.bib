	title = {3-{D} {Surface} {Deformation} {Performance} for {Simultaneous} {Squinted} {SAR} {Acquisitions}},
	url = {http://fringe.esa.int/},
	abstract = {This contribution addresses the performance in the retrieval of 3-D mean deformation maps by exploiting simultaneous or quasisimultaneous
squinted synthetic aperture radar (SAR) interferometric acquisitions. In multi-satellite or multi-beam low Earth
observation (LEO) missions the availability of two (or more) lines of sight (LOS) allows the simultaneous acquisition of SAR images
