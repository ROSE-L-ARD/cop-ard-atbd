	pages = {107--110},
}

@article{LundgrenSourcemodelCopahue2017,
	title = {Source model for the {Copahue} volcano magma plumbing system constrained by {InSAR} surface deformation observations},
	volume = {122},
	issn = {2169-9356},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/2017JB014368/full},
