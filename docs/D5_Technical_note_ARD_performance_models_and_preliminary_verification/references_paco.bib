@article{jong-sen_speckle_1981,
	title = {Speckle analysis and smoothing of synthetic aperture radar images},
	volume = {17},
	issn = {0146-664X},
	url = {http://www.sciencedirect.com/science/article/pii/S0146664X81800056},
	doi = {10.1016/S0146-664X(81)80005-6},
	abstract = {Coherent processing of synthetic aperture radar (SAR) data makes images susceptible to speckles. Basically, the speckles are signal-dependent and, therefore, act like multiplicative noise. This paper develops a statistical technique to define a noise model, and then successfully applies a local statistics noise filtering algorithm to a set of actual SEASAT SAR images. The smoothed images permit observers to resolve fine detail with an enhanced edge effect. Several SEASAT SAR images are used for demonstration.},
	number = {1},
	urldate = {2012-01-05},
	journal = {Computer Graphics and Image Processing},
