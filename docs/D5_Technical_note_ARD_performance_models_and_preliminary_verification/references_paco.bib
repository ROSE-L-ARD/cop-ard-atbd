@article{mason_accurate_1996,
	title = {Accurate and efficient determination of the shoreline in {ERS}-1 {SAR} images},
	volume = {34},
	issn = {0196-2892},
	doi = {10.1109/36.536540},
	abstract = {Extraction of the shoreline in SAR images is a difficult task to perform using simple image processing operations such as grey-value thresholding, due to the presence of speckle and because the signal returned from the sea surface may be similar to that from the land. A semiautomatic method for detecting the shoreline accurately and efficiently in ERS-1 SAR images is presented. This is aimed primarily at a particular application, namely the construction of a digital elevation model of an intertidal zone using SAR images and hydrodynamic model output, but could be carried over to other applications. A coarse-fine resolution processing approach is employed, in which sea regions are first detected as regions of low edge density in a low resolution image, then image areas near the shoreline are subjected to more elaborate processing at high resolution using an active contour model. Over 90\% of the shoreline detected by the automatic delineation process appear visually correct},
	number = {5},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Mason, D. C. and Davenport, I. J.},
	month = sep,
	year = {1996},
	keywords = {Active contours, ERS-1, Hydrodynamics, Image edge detection, Image resolution, SAR, Sea surface, active contour model, beach, coastal geomorphology, digital elevation model, digital elevation models, edge detection, geomorphology, geophysical measurement technique, geophysical signal processing, geophysical techniques, image processing, intertidal zone, land surface, land surface topography, ocean, oceanographic techniques, radar imaging, radar remote sensing, remote sensing by radar, sea coast, semiautomatic method, shoreline, signal processing, spaceborne radar, speckle, synthetic aperture radar, terrain mapping, topography (Earth)},
	pages = {1243--1253},
}

@article{gade_classification_2008,
	series = {Remote {Sensing} {Data} {Assimilation} {Special} {Issue}},
	title = {Classification of sediments on exposed tidal flats in the {German} {Bight} using multi-frequency radar data},
	volume = {112},
	issn = {0034-4257},
	url = {http://www.sciencedirect.com/science/article/pii/S0034425707004099},
	doi = {10.1016/j.rse.2007.08.015},
	abstract = {We present a new method for the extraction of roughness parameters of sand ripples on exposed tidal flats from multi-frequency synthetic aperture radar (SAR) data. The method is based on the Integral Equation Model (IEM) which predicts the normalized radar cross-section (NRCS) of randomly rough dielectric surfaces. The data used for this analysis were acquired in the German Bight of the North Sea by the Spaceborne Imaging Radar-C/X-Band SAR (SIR-C/X-SAR) in 1994. In-situ measurements of the root-mean-squared (rms) height and the correlation length of the sand ripples clearly demonstrate a relationship between these roughness parameters and the C-band NRCS determined from an ERS SAR image. Using the IEM we have calculated NRCS isolines for the three frequency bands deployed by SIR-C/X-SAR (L, C, and X band), as a function of the rms height and the correlation length of the sand ripples. For each SIR-C/X-SAR image pixel these two roughness parameters were determined from the intersections of the NRCS isolines at different radar bands, and they were used for a crude sediment classification for a small test area at the German North Sea coast. Comparing our results with available sediment maps, we conclude that the presented method is very promising for tidal flat classification by using data from presently existing airborne and future spaceborne multi-frequency SAR systems.},
	number = {4},
	urldate = {2017-05-08},
	journal = {Remote Sensing of Environment},
	author = {Gade, Martin and Alpers, Werner and Melsheimer, Christian and Tanck, Gerd},
	month = apr,
	year = {2008},
	keywords = {Integral equation model, Sediment classification, radar remote sensing, synthetic aperture radar, tidal flats},
	pages = {1603--1613},
}

@article{heygster_topographic_2010,
	title = {Topographic {Mapping} of the {German} {Tidal} {Flats} {Analyzing} {SAR} {Images} {With} the {Waterline} {Method}},
	volume = {48},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2009.2031843},
	abstract = {The waterline method is used to derive the topography of the tidal flats along the German coast by evaluation of synthetic aperture radar (SAR) images. A series of about 70 European Remote Sensing Satellites SAR images of the German Bight taken at different water levels within four years is analyzed to detect the borderline between tidal flats and adjacent water areas using a wavelet-based edge-detection algorithm. After geocoding, the waterlines are combined with the corresponding water levels to represent the topography on an irregularly spaced grid. The water levels are taken from a numerical tide model and corrected with the measured gauge data. Interpolation of these data into a regular grid yields a topographic map of the intertidal zone. While the general practicability of this method has been demonstrated in previous studies for smaller test areas, this paper is the first attempt to generate maps of a large area on a yearly basis.},
	number = {3},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Heygster, G. and Dannenberg, J. and Notholt, J.},
	month = mar,
	year = {2010},
	keywords = {European Remote Sensing Satellites SAR images, German coast, Monitoring, Radar, gauge data, geocoding, intertidal zone, numerical tide model, oceanographic regions, remote sensing by radar, spaced grid, synthetic aperture radar, synthetic aperture radar (SAR), synthetic aperture radar images, tidal flats, tides, topographic mapping, topography (Earth), water levels, waterline method, wavelet, wavelet-based edge-detection algorithm},
	pages = {1019--1030},
}

