	title = {{SIGNAL}: {SAR} {FOR} {ICE}, {GLACIER} {AND} {GLOBAL} {DYNAMICS}},
	shorttitle = {{SIGNAL}},
	url = {http://elib.dlr.de/64578/},
	urldate = {2010-09-20},
	booktitle = {Proceedings of {IEEE} {Geoscience} and {Remote} {Sensing} {Symposium} ({IGARSS}) 2010},
	author = {Börner, Thomas and De Zan, Francesco and López-Dekker, Francisco and Krieger, Gerhard and Hajnsek, Irena and Papathanassiou, Kostas and Villano, Michelangelo and Younis, Marwan and Danklmayer, Andreas and Dierking, Wolfgang and Nagler, Thomas and Rott, Helmut and Lehner, Susanne and Fügen, Thomas and Moreira, Alberto},
	month = jul,
	year = {2010},
	note = {SIGNAL is an innovative earth exploration mission proposal
with the main objective to estimate accurately and repeatedly topography and topographic changes associated with mass change or other dynamic effects on glaciers, ice caps and polar ice sheets. Elevation measurements are complemented
with glacier velocity measurements, providing valuable additional information for a better understanding of the hydrology of glacierized basins and of the Arctic and Antarctic water cycle. SIGNAL is capable of monitoring all critical regions with a high spatial resolution and an adequate revisit time. This paper gives an overview about the actual mission design status and provides a brief description of the topography (DEM – digital elevation map) self-calibration strategy and the estimated global interferometric performance.},
	keywords = {Microwaves and Radar Institute, Radar Concepts},
}

