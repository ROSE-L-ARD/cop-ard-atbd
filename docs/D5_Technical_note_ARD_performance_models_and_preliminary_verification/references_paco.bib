	journal = {Geoscience and Remote Sensing Letters, IEEE},
	author = {Farquharson, G. and Junek, W.N. and Ramanathan, A. and Frasier, S.J. and Tessier, R. and McLaughlin, D.J. and Sletten, M.A. and Toporkov, J.V.},
	year = {2004},
	keywords = {25 MHz, 5.3 GHz, WP-3D research aircraft, aircraft instrumentation, aircraft pod, coastal regions, land surfaces, notable look-angle dependences, oceanographic equipment, oceanographic regions, pod-based dual-beam SAR, radar cross-sections, radar imagery, radar imaging, remote sensing by radar, sea surface normalized radar cross section, sea surface processes, seawater, synthetic aperture radar, system hardware, test flights, track interferometric synthetic aperture radar, very low wind conditions, water surfaces},
