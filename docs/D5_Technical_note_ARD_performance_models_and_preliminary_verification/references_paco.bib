@inproceedings{prats_distributed_2011,
	title = {Distributed imaging with {TerraSAR}-{X} and {TanDEM}-{X}},
	doi = {10.1109/IGARSS.2011.6050099},
	abstract = {This paper reports on several experiments performed with the TerraSAR-X (TSX) and the TanDEM-X (TDX) satellites. The experiments consist in the generation of improved image products by coherently combining the images acquired individually by both satellites, hence the name distributed imaging. In the literature it has already been suggested the use of two or more satellites in close formation not only to have interferometric capabilities, but also to improve the azimuthal or range resolutions by performing the acquisitions simultaneously (no temporal decorrelation). This idea can be carried out by acquiring different portions of the spectrum and adding them coherently afterwards. Another possibility is to synthesize quad-pol acquisitions using dual-pol ones, an idea already carried out with airborne systems. Such experiments have been performed with TSX and TDX and are described in this paper.},
	booktitle = {Geoscience and {Remote} {Sensing} {Symposium} ({IGARSS}), 2011 {IEEE} {International}},
	author = {Prats, P. and Lopez-Dekker, P. and De Zan, F. and Wollstadt, S. and Bachmann, M. and Steinbrecher, U. and Scheiber, R. and Reigber, A. and Krieger, G.},
	month = jul,
	year = {2011},
	keywords = {Distributed imaging, Image resolution, TDX satellite, TSX satellite, TanDEM-X satellite, TerraSAR-X satellite, airborne system, dual-pol acquisition synthesis, image acquisition, interferometric capability, quadpol acquisition synthesis, radar imaging, radar interferometry},
	pages = {3963 --3966},
}

@article{rodriguez-cassola_non-nominal_2012,
	title = {Non-nominal experimental bistatic {SAR} acquisitions with {TanDEM}-{X}},
	abstract = {TanDEM-X is a high-resolution interferometric mission with the main goal of providing a global and unprecedentedly accurate digital elevation model (DEM) of the Earth surface by means of single-pass X-band SAR interferometry. Despite its usual quasi-monostatic configuration, TanDEM-X is the first genuinely bistatic SAR system in space. During its monostatic commissioning phase, the system has been mainly operated in pursuit monostatic mode. However, some pioneering bistatic SAR experiments with both satellites commanded in non-nominal modes have been conducted with themain purpose of testing the performance of both space and ground segments in very demanding scenarios. In particular, this paper reports about the first bistatic acquisition and the first single-pass interferometric (mono/bistatic) acquisition with TanDEM-X, addressing their innovative aspects and focussing on the analysis of the experimental results. Even in the absence of essential synchronisation and calibration information, bistatic images and interferograms with similar quality to pursuit monostatic have been obtained.},
	journal = {Synthetic Aperture Radar, 2012. EUSAR. 9th European Conference on},
	author = {Rodriguez-Cassola, Marc and Prats, Pau and Schulze, Daniel and Steinbrecher, Ulrich and Tous-Ramon, Nuria and Younis, Marwan and Lopez-Dekker, Paco and Zink, Manfred and Reigber, Andreas and Moreira, Alberto and Krieger, Gerhard},
	month = apr,
	year = {2012},
	pages = {155 --158},
}

@article{krieger_digital_2012,
	title = {Digital beamforming and {MIMO} {SAR}: {Review} and new concepts},
	shorttitle = {Digital beamforming and {MIMO} {SAR}},
	abstract = {Spaceborne Synthetic Aperture Radar (SAR) is a unique tool for large scale Earth observation, but the current generation of SAR sensors suffers from some fundamental limitations with regard to their imaging and mapping capabilities. To overcome these limitations, several new instrument architectures and SAR imaging modes have been suggested that employ digital beamforming (DBF), multiple aperture data recording and MIMO SAR techniques. This paper provides a critical review of these techniques and makes some suggestions for further improvements. Special attention is given to advanced DBF and MIMO SAR concepts for ultra-wide swath imaging.},
	journal = {Synthetic Aperture Radar, 2012. EUSAR. 9th European Conference on},
	author = {Krieger, G. and Younis, M. and Huber, S. and Bordoni, F. and Patyuchenko, A. and Kim, J. and Laskowski, P. and Villano, M. and Rommel, T. and Lopez-Dekker, P. and Moreira, A.},
	month = apr,
