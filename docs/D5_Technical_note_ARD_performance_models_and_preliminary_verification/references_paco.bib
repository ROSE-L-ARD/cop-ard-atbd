	year = {2004},
	keywords = {AD 2008 to 2009, DEM, DTED-3 specification, Digital Terrain Elevation Data, German Earth Observation Mission, PRF, Pulse Repetition Frequency, TanDEM-X mission, TerraSAR-X add-on satellite, close orbit configuration, global Digital Elevation Model, interferometry, operation mode, orbit selection, phase A study, phase synchronization, scientific application, single-pass SAR interferometry, synthetic aperture radar, terrain mapping},
	pages = {1000--1003 vol.2},
}

@article{bamler_comparison_1992,
	title = {A comparison of range-{Doppler} and wavenumber domain {SAR} focusing algorithms},
	volume = {30},
	issn = {0196-2892},
	doi = {10.1109/36.158864},
	abstract = {Focusing of SAR data requires a space-variant two-dimensional
correlation. Different algorithms are compared with each other in terms
of their focusing quality and their ability to handle the space-variance
