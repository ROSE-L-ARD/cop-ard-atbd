	title = {A power law phase screen model for ionospheric scintillation. {I} - {Weak} scatter. {II} - {Strong} scatter},
	volume = {14},
	issn = {0048-6604},
	url = {http://adsabs.harvard.edu/abs/1979RaSc...14.1135R},
