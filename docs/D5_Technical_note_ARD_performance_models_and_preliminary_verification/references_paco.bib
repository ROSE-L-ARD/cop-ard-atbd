	month = oct,
	year = {2016},
	keywords = {\$Omega\$-weighting, Azimuth, Gain, Gratings, Image resolution, Look-Normalized Pattern Correction (LNPC), Phased arrays, TerraSAR-X WSS acquisitions, azimuth steering capability, extended image performance, geophysical image processing, grating lobes, image denoising, image noise, improved azimuth geometric resolution, look-normalized pattern correction, phased array SAR, phased array radar, point targets, radiometric resolution, remote sensing by radar, speckle, speckle noise, steering directions, synthetic aperture radar, synthetic aperture radar (SAR), wrapped staring spotlight (WSS), wrapped staring spotlight SAR imaging mode},
	pages = {5745--5764},
}

@article{prats-iraolaPerformance3DSurface2018,
	title = {Performance of 3-{D} {Surface} {Deformation} {Estimation} for {Simultaneous} {Squinted} {SAR} {Acquisitions}},
	volume = {56},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2017.2776140},
	abstract = {This paper addresses the performance in the retrieval of 3-D mean deformation maps by exploiting simultaneous or quasi-simultaneous squinted synthetic aperture radar (SAR) interferometric acquisitions in a repeat-pass scenario. In multisatellite or multibeam low earth observation missions, the availability of two (or more) lines of sight (LOSs) allows the simultaneous acquisition of SAR images with different squint angles, hence improving the sensitivity to the north-south component of the deformation. Due to the simultaneity of the acquisitions, the troposphere will be highly correlated and, therefore, will tend to cancel out when performing the differential measurement between the interferograms obtained with the different LOSs, hence resulting in a practically troposphere-free estimation of the along-track deformation measurement. In practice, however, the atmospheric noise in the differential measurement will increase for increasing angular separations. This paper expounds the mathematical framework to derive the performance by properly considering the correlation of the atmospheric delays between the simultaneous acquisitions. To that aim, the hybrid Cramér-Rao bound is exploited making use of the autocorrelation function of the troposphere. Some performance examples are presented in the frame of future spaceborne SAR missions at C and L band.},
	number = {4},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Prats-Iraola, P. and Lopez-Dekker, P. and Zan, F. De and Yagüe-Martínez, N. and Zonno, M. and Rodriguez-Cassola, M.},
	month = apr,
	year = {2018},
	keywords = {3D mean deformation map retrieval, 3D surface deformation estimation performance, Atmospheric boundary layer (ABL), Atmospheric measurements, C band, Extraterrestrial measurements, Geometry, L band, LOSs, Satellites, Strain, Synthetic aperture radar, Terrestrial atmosphere, \_tablet, along-track deformation measurement, angular separations, atmospheric delay correlation, atmospheric noise, deformation, differential measurement, differential synthetic aperture radar interferometry (DInSAR), future spaceborne SAR missions, hybrid Cramér-Rao bound, hybrid Cramér–Rao bound (HCRB), interferograms, lines of sight, mathematical framework, multibeam low earth observation missions, multisatellite earth observation missions, north-south component sensitivity, quasisimultaneous squinted synthetic aperture radar interferometric acquisitions, radar imaging, radar interferometry, remote sensing by radar, repeat-pass scenario, simultaneous SAR image acquisition, simultaneous squinted SAR acquisitions, spaceborne radar, squint angles, squinted synthetic aperture radar acquisitions, synthetic aperture radar, synthetic aperture radar (SAR), troposphere, troposphere autocorrelation function, troposphere-free estimation},
	pages = {2147--2158},
}

@article{bordoniBeamSwitchWideSwathMode2018,
	title = {Beam-{Switch} {Wide}-{Swath} {Mode} for {Interferometrically} {Compatible} {Single}-{Pol} and {Quad}-{Pol} {SAR} {Products}},
	volume = {15},
	issn = {1545-598X},
	doi = {10.1109/LGRS.2018.2849269},
	abstract = {Future spaceborne synthetic aperture radar (SAR) systems are expected to deliver enormous quantity of data. Accordingly, the observation plan becomes crucial for a proper allocation of the mission resources. A central challenge is to reduce the number of acquisitions by making the same image available for more applications. Here, a relevant restriction is the interferometric incompatibility between fully polarimetric (QP) and single polarimetric (SP) SAR images, which typically occurs when the acquisitions are performed in burst mode, as in case of SAR products with wide coverage acquired by means of ScanSAR or terrain observation by progressive scanning (TOPS) technique. In order to overcome this limitation, a new operational mode, denoted as beam-switch wide-swath (BSWS), was conceived. The BSWS mode exploits the operational flexibility of future SAR systems to generate SP images, interferometrically compatible with the QP ones, keeping the wide coverage characteristic of the SP products. This letter presents in detail the BSWS mode, analyzing its functional principle, and imaging performance, based on a realistic future SAR system, the high-resolution wide-swath (HRWS) SAR, considered for the next generation of the Sentinel-1 mission.},
	number = {10},
	journal = {IEEE Geoscience and Remote Sensing Letters},
	author = {Bordoni, F. and López-Dekker, P. and Krieger, G.},
	month = oct,
	year = {2018},
	keywords = {Azimuth, Digital beamforming (DBF), Imaging, Radar polarimetry, Spatial resolution, Synthetic aperture radar, Timing, high-resolution wide-swath (HRWS), interferometry, multichannel synthetic aperture radar (SAR)},
	pages = {1565--1569},
}

@article{molijnVegetationCharacterizationUse2018,
	title = {Vegetation {Characterization} through the {Use} of {Precipitation}-{Affected} {SAR} {Signals}},
	volume = {10},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	url = {https://www.mdpi.com/2072-4292/10/10/1647},
	doi = {10.3390/rs10101647},
	abstract = {Current space-based SAR offers unique opportunities to classify vegetation types and to monitor vegetation growth due to its frequent acquisitions and its sensitivity to vegetation geometry. However, SAR signals also experience frequent temporal fluctuations caused by precipitation events, complicating the mapping and monitoring of vegetation. In this paper, we show that the influence of a priori known precipitation events on the signals can be used advantageously for the classification of vegetation conditions. For this, we exploit the change in Sentinel-1 backscatter response between consecutive acquisitions under varying wetness conditions, which we show is dependent on the state of vegetation. The performance further improves when a priori information on the soil type is taken into account.},
	language = {en},
	number = {10},
	urldate = {2018-10-19},
	journal = {Remote Sensing},
