@article{pfister_wave-like_1971,
	title = {The wave-like nature of inhomogeneities in the {E}-region},
	volume = {33},
	issn = {0021-9169},
	url = {http://www.sciencedirect.com/science/article/pii/0021916971901231},
	doi = {10.1016/0021-9169(71)90123-1},
	abstract = {An important modification of the standard drift experiment is the addition of phase recordings. This, together with an application of the generalized correlation analysis as formulated by Booker et al. (1950) allows a better interpretation of the data in terms of ionospheric structure at the reflection level. Drift measurements of the lower E-region at Billerica, Mass., U.S.A. are interpreted with a generalized correlation and spectral analysis. The most striking result is the linear arrangement of individual Doppler shifted lines in the phase spectrum, which leads to the concept of a wave-like character of the ionospheric motions. It is difficult to reconcile these findings with the results of the full correlation analysis. However, favorable comparison with the similar fade method can be noted.},
