	author = {Arnold-Bos, A. and Khenchaf, A. and Martin, A.},
	month = nov,
	year = {2007},
	keywords = {Bistatic radar, backscatter, bistatic radar equation, bistatic radar imaging, bistatic scattering, bistatic synthetic aperture radar, marine environment, marine radar, marine surveillance systems, multistatic configuration, oceanographic techniques, pseudoraw signals, radar clutter, radar imaging, radar receiver, radar simulation, radar theory, radar transmitter, remote sensing by radar, sea state phenomenology, sea surface electromagnetic scattering, ship wake detection algorithm, synthetic aperture radar, synthetic aperture radar (SAR) imagery, transmit-receive time},
	pages = {3372--3383},
}

