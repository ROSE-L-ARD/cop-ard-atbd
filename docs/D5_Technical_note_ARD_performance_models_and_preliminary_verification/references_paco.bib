	month = jul,
	year = {2011},
	keywords = {Bistatic radar, DEM accuracy, German TanDEM-X mission, SAR processing, Satellites, TANDEM-X, TDX, TSX, TanDEM-X data, TerraSAR-X, artificial satellites, bistatic SAR data processing, bistatic interferometer, bistatic processing, bistatic synchronization, celestial mechanics, close orbit formation, digital elevation models, interferometry, oscillator synchronization, oscillators, phase measurement, radar interferometry, radar signal processing, satellite oscillator synchronization, signal to noise ratio, spaceborne radar, synchronisation, synchronization, synthetic aperture radar},
