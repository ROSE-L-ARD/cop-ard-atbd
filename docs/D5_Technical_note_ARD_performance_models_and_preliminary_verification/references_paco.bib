@article{iglesias_new_2012,
	title = {A new approach to {DInSAR} pixel selection with spectral correlation along time between {Sublooks}},
	abstract = {This paper presents a full resolution pixel selection method, alternative to the traditional ones, which is based on the study of the spectral correlation coefficient along time among different Sublooks of the image spectrum. This pixel selection criterion has been developed from the concept of the so-called Coherent Scatters (CSs), which are characterized by a deterministic point-like scattering behaviour in each single acquisition, but now including its temporal stability. The proposed method presents the advantage that it does not require any radiometric calibration of the data as it only uses the spectral properties of a point-scatter but not relying on its amplitude.},
	journal = {Synthetic Aperture Radar, 2012. EUSAR. 9th European Conference on},
	author = {Iglesias, Ruben and Monells, Dani and Centolanza, Giuseppe and Mallorqui, Jordi J. and Lopez-Dekker, Paco},
