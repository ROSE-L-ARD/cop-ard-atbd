@article{liangSuppressionCO2Outgassing2020,
	title = {Suppression of {CO2} {Outgassing} by {Gas} {Bubbles} {Under} a {Hurricane}},
	volume = {47},
	copyright = {©2020. American Geophysical Union. All Rights Reserved.},
	issn = {1944-8007},
	url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/2020GL090249},
	doi = {https://doi.org/10.1029/2020GL090249},
	abstract = {The role of gas bubbles on the air-sea CO2 flux during Hurricane Frances (2004) is studied using a large-eddy simulation model that couples ocean surface boundary layer turbulence, gas bubbles, and dissolved gases. In the subtropical surface ocean where gases are slightly supersaturated, gases in bubbles can still dissolve due to hydrostatic pressure and surface tension exerted on bubbles. Under the simulated conditions, the CO2 efflux with an explicit bubble effect is less than 2\% of that calculated using a gas flux formula without explicit inclusion of bubble effect. The use of a gas flux parameterization without bubble-induced supersaturation contributes to uncertainty in the global carbon budget. The results highlight the importance of bubbles under high winds even for soluble gases such as CO2 and demonstrate that gas flux parameterization derived from gases of certain solubility may not be accurate for gases of very different solubility.},
	language = {en},
	number = {18},
	urldate = {2020-11-10},
	journal = {Geophysical Research Letters},
	author = {Liang, Jun-Hong and D'Asaro, Eric A. and McNeil, Craig L. and Fan, Yalin and Harcourt, Ramsey R. and Emerson, Steven R. and Yang, Bo and Sullivan, Peter P.},
	year = {2020},
	note = {\_eprint: https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2020GL090249},
	pages = {e2020GL090249},
}

