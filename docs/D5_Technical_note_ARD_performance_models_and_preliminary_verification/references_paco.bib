	keywords = {AIEM model, Bistatic scattering, Fresnel reflection, Geometrical optics, IEM-based models, Integral equations, Kirchhoff approximation (KA), Kirchhoff approximation standard model, Kirchhoff surface field, Kirchhoff's Law, Optical scattering, Predictive models, Rough surfaces, Sea surface, Solid modeling, Surface roughness, advanced integral equation model, bistatic scattering, geometrical optics, geometrical optics model, geometrical optics model (GOM), integral equation model (IEM), perturbation techniques, random processes, randomly rough surfaces, remote sensing, rough surface, small perturbation model, small perturbation model (SPM), surface current term},
