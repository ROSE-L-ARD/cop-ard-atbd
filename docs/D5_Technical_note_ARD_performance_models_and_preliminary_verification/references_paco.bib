	issn = {0196-2892},
	doi = {10.1109/36.544558},
	abstract = {An automated algorithm intended for operational use is developed and tested for estimating wind speed and direction using ERS-1 SAR imagery. The wind direction comes from the orientation of low frequency, linear signatures in the SAR imagery that the authors believe are manifestations of roll vortices within the planetary boundary layer. The wind direction thus has inherently a 180° ambiguity since only a single SAR image is used. Wind speed is estimated by using a new algorithm that utilizes both the estimated wind direction and σ 0 values to invert radar cross section models. The authors show that: 1) on average the direction of the roll vortices signatures is approximately 11° to the right of the surface wind direction and can be used to estimate the surface wind direction to within ±19° and 2) utilizing these estimated wind directions from the SAR imagery subsequently improves wind speed estimation, generating errors of approximately ±1.2 m/s, for ERS-1 SAR data collected during the Norwegian Continental Shelf Experiment in 1991},
	number = {6},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Wackerman, C.C. and Rufenach, C. and Shuchman, R.A. and Johannessen, J.A. and Davidson, K.L.},
	month = nov,
	year = {1996},
	keywords = {ERS-1, Image retrieval, Radar scattering, SAR image, SAR method, Satellites, Sea surface, Spatial resolution, Wind speed, ambiguity, atmosphere, atmospheric techniques, automated algorithm, geophysical signal processing, marine boundary layer, measurement technique, operational use, radar cross section, radar imaging, radar measurements, radar remote sensing, remote sensing by radar, roll vortex, roll vortices, spaceborne radar, synthetic aperture radar, synthetic aperture radar imagery, wind, wind direction, wind vector retrieval},
	pages = {1343--1352},
}

@article{toporkov_sea_2005,
	title = {Sea surface velocity vector retrieval using dual-beam interferometry: first demonstration},
	volume = {43},
	issn = {0196-2892},
	shorttitle = {Sea surface velocity vector retrieval using dual-beam interferometry},
	doi = {10.1109/TGRS.2005.848603},
	abstract = {The dual-beam interferometer consists of two interferometric synthetic aperture radars (InSARs), one squinted at 20° forward of broadside, and the other 20° aft, to allow measurement of vector surface velocity with only a single aircraft pass. Estimates of surface velocity vectors in the coastal region during high tidal flow are presented. The data were gathered over the barrier islands west of Fort Myers, Florida, as part of a March 2004 deployment. Whereas no detailed bathymetry data were available, high-quality aerial photography appears to be a useful tool in inferring bottom topography and possible current obstructions. The retrieved velocity field clearly follows the expected outflow pattern. While comparisons with tidal current magnitudes predicted by the U.S. National Ocean Service do reveal discrepancies of up to 0.5 m/s, these differences are most likely due to the contribution of ocean surface waves to the overall InSAR velocity measurement. Velocity retrievals for the same area based on the data from different tracks show good consistency. The results constitute the first demonstration of vector retrieval of the surface velocity field with a single-pass InSAR system and confirm the robustness of the dual-beam interferometry principle.},
	number = {11},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Toporkov, J.V. and Perkovic, D. and Farquharson, G. and Sletten, M.A. and Frasier, S.J.},
	month = nov,
	year = {2005},
	keywords = {AD 2004 03, Aircraft, Florida, Fort Myers, Oceans, Photography, Sea measurements, Sea surface, Surface topography, Surface waves, Synthetic aperture radar interferometry, U.S. National Ocean Service, USA, aerial photography, along-track interferometry, bathymetry, bathymetry data, bottom topography, dual-beam interferometry, interferometric SAR, ocean surface currents, ocean surface waves, ocean waves, oceanographic techniques, radiowave interferometry, remote sensing by radar, sea surface velocity vector retrieval, synthetic aperture radar, synthetic aperture radar (SAR), topography (Earth), velocity measurement},
	pages = {2494--2502},
}

@article{kim_measurements_2003,
	title = {Measurements of ocean surface waves and currents using {L}- and {C}-band along-track interferometric {SAR}},
	volume = {41},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2003.817210},
	abstract = {Along-track interferometric synthetic aperture radar (ATI-SAR) is an active coherent imaging system, utilizing two antennas separated along the platform flight direction. The phase information of ATI-SAR from the Doppler shift of the backscattered signal represents the line-of-sight velocity of the water scatterers. While the advent of ATI-SAR provided us with a potentially powerful technique for ocean surface current and wave mapping, the surface current has not been measured exactly from the ATI-SAR velocity because the Doppler shift is not simply proportional to the component of the mean surface current. It also includes other types of contributions associated with the phase velocity of the Bragg waves and orbital motions of all ocean waves that are longer than Bragg waves. In this paper, we review how the phase difference measured by ATI-SAR is related to the mean Doppler frequency, and we develop a new and practically useful method to extract the surface current component utilizing simultaneously measured L- and C-band ATI-SAR data. Since the measured ATI-SAR velocity shows a different value at a different radar-frequency, we investigate the influence of Bragg-resonant waves and long ocean wave motions on the ATI-SAR velocity according to the radar frequency. The Bragg-wave phase velocity component, which is a significant source of error for extracting the surface current, can be effectively eliminated by using L- and C-band ATI-SAR. The method is applied to L- and C-band ATI-SAR measurements acquired at the Ulsan coast in the southeastern part of the Korean peninsula. The resulting ocean surface current vectors are compared with in situ measurements collected by recording current meter. We furthermore extract ocean surface wave information from the ATI-SAR phase image using a quasi-linear transform.},
	number = {12},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Kim, Duk-jin and Moon, W.M. and Moller, D. and Imel, D.A.},
	year = {2003},
	keywords = {ATI-SAR, Bragg waves, Bragg-wave phase velocity component, C-band, Current measurement, Data mining, Doppler radar, Doppler shift, Extraterrestrial measurements, Frequency measurement, Korean peninsula, L Band, L- and C-Band Along-Track Interferometric SAR, Oceans, Sea measurements, Sea surface, Surface waves, Ulsan coast, active coherent imaging system, backscattered signal, ocean surface currents, ocean surface waves, ocean waves, oceanographic techniques, orbital motions, phase information, phase velocity, radiowave interferometry, synthetic aperture radar, velocity measurement},
	pages = {2821--2832},
}

@article{frasier_dual-beam_2001,
	title = {Dual-beam interferometry for ocean surface current vector mapping},
	volume = {39},
	issn = {0196-2892},
	doi = {10.1109/36.905248},
	abstract = {The recent use of along-track interferometry (ATI) in synthetic aperture radar (SAR) has shown promise for synoptic measurement of ocean surface currents. ATI-SARs have been used to estimate wave fields, currents, and current features. This paper describes and analyzes a dual-beam along-track interferometer to provide spatially resolved vector surface velocity estimates with a single pass of an aircraft. The design employs a pair of interferometer beams, one squinted forward and one squinted aft. Each interferometric phase is sensitive to the component of surface Doppler velocity in the direction of the beam. Therefore, a proper combination of these measurements provides a vector surface velocity estimate in one pass of the aircraft. The authors find that precise measurements dictate widely spaced beams and that the spatial resolution for the squinted SAR is essentially identical to the sidelooking case. Practical instrument design issues are discussed, and an airborne system currently in development is described. Through computer simulation, they observe the azimuthal displacement of interferometric phases by moving surfaces identical to those of conventional SAR and find that such displacement can bias the estimated surface velocity},
	number = {2},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Frasier, S.J. and Camps, A.J.},
	month = feb,
	year = {2001},
	keywords = {Aircraft, Current measurement, InSAR, Instruments, Oceans, SAR, Sea measurements, Sea surface, Spatial resolution, airborne method, airborne radar, along-track interferometer, along-track interferometry, azimuthal displacement, dual-beam interferometry, dynamics, interferometry, measurement technique, moving surface, ocean, oceanographic techniques, radar interferometry, radar remote sensing, remote sensing by radar, surface current, synoptic measurement, synthetic aperture radar, vector mapping, vector surface velocity, velocity measurement},
	pages = {401--414},
}

@article{younis_digital_2003,
	title = {Digital beamforming in {SAR} systems},
	volume = {41},
	issn = {0196-2892},
	doi = {10.1109/TGRS.2003.815662},
	abstract = {The rapid progression in digital hardware and signal processing capabilities stimulates the development of radar systems. The tendency is to move the digital interface toward the antenna, replacing, whenever possible, analog RF-hardware. Based on software codes, these digital systems are more flexible and easier to reconfigure than RF-hardware. This letter illustrates the general concept for digital beamforming (DBF) in synthetic aperture radar systems and investigates their principle capabilities, limitations, and performance parameters. It is shown that using DBF a simultaneous improvement in azimuth coverage and resolution can be achieved.},
